# Supabase Public Configuration (Safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Telegram Mini App
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_MINIAPP_URL=https://your-app.example.com/
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=uz_hamyonbot
TELEGRAM_WEBHOOK_SECRET=your-optional-telegram-webhook-secret

# Internal proxy/server signing secret (required in production)
INTERNAL_AUTH_SECRET=generate-a-long-random-secret

# Server-side Only Secrets (Never expose to client or prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key
